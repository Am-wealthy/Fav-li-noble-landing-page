# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Nodemailer / Gmail SMTP Configuration (Server-Side Only - Never expose to browser)
# Generate an App Password in Google Account > Security > 2-Step Verification > App Passwords
EMAIL_USER="your-gmail-account@gmail.com"
EMAIL_PASS="your-16-char-app-password"
RECEIVER_EMAIL="boboike600@gmail.com"

# Optional: If hosting frontend on a different domain/CDN (e.g. Vercel) pointing to backend
# VITE_API_URL="https://your-backend.railway.app"
